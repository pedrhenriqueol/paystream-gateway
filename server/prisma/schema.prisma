generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["paystream"]
}

enum MerchantPlan {
  STARTER
  PRO
  ENTERPRISE

  @@schema("paystream")
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  BOLETO

  @@schema("paystream")
}

enum TransactionStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
  CHARGEBACK

  @@schema("paystream")
}

enum WebhookStatus {
  DELIVERED
  FAILED
  RETRYING

  @@schema("paystream")
}

model Merchant {
  id            String       @id @default(uuid())
  name          String
  slug          String       @unique
  document      String
  plan          MerchantPlan @default(PRO)
  apiKeyLive    String       @unique
  webhookSecret String
  webhookUrl    String?
  feePercent    Decimal      @default(2.99)
  feeFixed      Decimal      @default(0.49)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  users        User[]
  recipients   Recipient[]
  transactions Transaction[]
  webhooks     WebhookLog[]

  @@map("merchants")
  @@schema("paystream")
}

model User {
  id           String   @id @default(uuid())
  merchantId   String   @map("merchant_id")
  name         String
  email        String
  passwordHash String   @map("password_hash")
  role         String   @default("MERCHANT_ADMIN")
  createdAt    DateTime @default(now()) @map("created_at")

  merchant     Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, email])
  @@map("users")
  @@schema("paystream")
}

model Recipient {
  id         String   @id @default(uuid())
  merchantId String   @map("merchant_id")
  name       String
  document   String
  bankCode   String
  agency     String
  account    String
  createdAt  DateTime @default(now()) @map("created_at")

  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  splits     SplitRule[]

  @@map("recipients")
  @@schema("paystream")
}

model Transaction {
  id             String            @id @default(uuid())
  merchantId     String            @map("merchant_id")
  externalId     String?           @map("external_id")
  amount         Decimal
  netAmount      Decimal
  feeAmount      Decimal
  paymentMethod  PaymentMethod     @map("payment_method")
  status         TransactionStatus @default(PENDING)
  customerName   String            @map("customer_name")
  customerEmail  String            @map("customer_email")
  customerDoc    String            @map("customer_doc")
  
  pixQrCode      String?           @map("pix_qrcode")
  pixPayload     String?           @map("pix_payload")
  cardLastDigits String?           @map("card_last_digits")
  cardBrand      String?           @map("card_brand")
  installments   Int               @default(1)
  
  paidAt         DateTime?         @map("paid_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  merchant          Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  splits            SplitRule[]
  webhookDeliveries WebhookLog[]

  @@unique([merchantId, externalId])
  @@index([merchantId, createdAt(sort: Desc)])
  @@index([merchantId, status])
  @@map("transactions")
  @@schema("paystream")
}

model SplitRule {
  id            String      @id @default(uuid())
  transactionId String      @map("transaction_id")
  recipientId   String      @map("recipient_id")
  amount        Decimal
  percent       Decimal?
  createdAt     DateTime    @default(now()) @map("created_at")

  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  recipient     Recipient   @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([recipientId])
  @@map("split_rules")
  @@schema("paystream")
}

model WebhookLog {
  id             String        @id @default(uuid())
  merchantId     String        @map("merchant_id")
  transactionId  String        @map("transaction_id")
  event          String
  payload        Json
  signature      String
  endpointUrl    String        @map("endpoint_url")
  responseStatus Int?          @map("response_status")
  status         WebhookStatus @default(DELIVERED)
  attempts       Int           @default(1)
  createdAt      DateTime      @default(now()) @map("created_at")

  merchant       Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  transaction    Transaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@map("webhook_logs")
  @@schema("paystream")
}
